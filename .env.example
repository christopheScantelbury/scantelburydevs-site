# ─────────────────────────────────────────────────────────────────────────────
# ScantelburyDevs — Variáveis de ambiente
# Copiar para .env.local e preencher conforme criar cada conta
# ─────────────────────────────────────────────────────────────────────────────

# ── ANALYTICS & TRACKING ────────────────────────────────────────────────────
# GA4 — Google Analytics (já em uso)
NEXT_PUBLIC_GA_ID=G-G8NLD2MG20

# Google Ads — pegar em Ferramentas → Configuração → Tags do Google Ads
# Formato: AW-XXXXXXXXX (9 dígitos depois do AW-)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Meta Pixel (Facebook + Instagram Ads)
# Pegar em business.facebook.com → Eventos → Pixels → ID do Pixel
# Formato: 15-16 dígitos
NEXT_PUBLIC_META_PIXEL_ID=

# LinkedIn Insight Tag (para retargeting LinkedIn)
# Pegar em campaignmanager.linkedin.com → Conta → Insight Tag
# Formato: número curto (ex: 1234567)
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Google Search Console (verificação)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── INTEGRAÇÕES BACKEND (não públicas) ──────────────────────────────────────
# Anthropic API — usada por DOIS assistentes:
#   • chat da home  → Claude Haiku  (/api/chat)
#   • secretária comercial (LP + WhatsApp) → Claude Sonnet (/api/secretaria, /api/whatsapp)
ANTHROPIC_API_KEY=

# Resend (notificações de lead por email)
RESEND_API_KEY=

# ── SECRETÁRIA COMERCIAL · WHATSAPP CLOUD API (Meta) ────────────────────────
# Painel: developers.facebook.com → seu App → WhatsApp → API Setup
# Token permanente (System User) — NÃO o token temporário de 24h
WHATSAPP_TOKEN=
# ID do número de telefone (Phone number ID), não o número em si
WHATSAPP_PHONE_NUMBER_ID=
# Token que VOCÊ inventa e repete na configuração do webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# Webhook a cadastrar na Meta: https://www.scantelburydevs.com.br/api/whatsapp
#   - Verify token: o mesmo WHATSAPP_VERIFY_TOKEN
#   - Campo a assinar: "messages"

# ── MEMÓRIA DE CONVERSA DO WHATSAPP (Supabase) ──────────────────────────────
# Sem isto, a memória cai num fallback em RAM (não persiste entre cold starts).
# URL do projeto Supabase (ex: https://xxxx.supabase.co)
SUPABASE_URL=
# Service role key (Settings → API). NUNCA expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Rodar antes: o SQL em supabase-wa.sql (cria a tabela wa_conversas)

# ── CRM · GOOGLE SHEETS (registro de leads) ─────────────────────────────────
# Service account no Google Cloud com a Google Sheets API habilitada.
# Compartilhar a planilha com o e-mail da service account (permissão de Editor).
GOOGLE_SA_EMAIL=
# Private key do JSON da service account (com \n escapados, entre aspas)
GOOGLE_SA_PRIVATE_KEY=
# ID da planilha (parte da URL entre /d/ e /edit)
GOOGLE_SHEETS_ID=
# Nome da aba (opcional; padrão "Leads")
GOOGLE_SHEETS_ABA=Leads
